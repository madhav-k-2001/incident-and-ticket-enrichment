# ==========================================
# Gemini API Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSION=768

# ==========================================
# Strict Rate-Limit Safeguards (100 RPM, 30K TPM, 1K RPD)
# ==========================================
RATE_LIMIT_MAX_RPM=80
RATE_LIMIT_MAX_TPM=24000
RATE_LIMIT_MAX_RPD=950

# ==========================================
# Database Configuration (pgvector PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ingestion_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ==========================================
# Redis Task Queue & Rate Limiter
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_QUEUE_NAME=ingestion:queue

# ==========================================
# Ingestion Chunking & Batching
# ==========================================
UPLOAD_DIR=./uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_BATCH_SIZE=30
TARGET_BATCH_TOKENS=6000
