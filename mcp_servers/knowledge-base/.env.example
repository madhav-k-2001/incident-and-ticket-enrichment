# pgvector database written by the ingestion pipeline (same names as ingestion/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ingestion_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=10

# Query embeddings: must match what the ingestion worker used.
# Leave GEMINI_API_KEY empty to use the ingestion pipeline's deterministic mock embeddings.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=2

# Max chunks stitched into one kb://documents/{id} resource
MAX_DOCUMENT_CHUNKS=2000

# MCP transport: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8100

LOG_LEVEL=INFO
