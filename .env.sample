# =============================================================================
# Root environment template. Copy to .env and fill in.
#
# Covers: backend app, alarms & ticketing simulator, the 3 MCP servers
# (alarm-management, ticketing, knowledge-base) and the ingestion pipeline.
# Per-component templates remain in each folder's .env.example.
#
# NOTE: one flat file is shared by every component.
#   - There is a single database (Neon Postgres). Every service connects to it:
#     the backend uses DATABASE_URL (or the POSTGRES_* parts), ingestion and the
#     knowledge-base MCP use the POSTGRES_* parts. Keep both in sync.
#   - MCP_TRANSPORT/MCP_HOST/MCP_PORT are NOT set here: they differ per MCP
#     server (stdio by default; docker-compose sets streamable-http and ports
#     8101/8102/8103). Set them in the shell when running a server by hand.
# =============================================================================

# ==========================================
# Backend app (apps/backend)
# ==========================================
# Comma-separated keys accepted in the X-API-Key header (protects /chat;
# /health stays open). Leave empty to disable auth (dev only).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# LLM used by the agent (OpenAI Agents SDK reads OPENAI_API_KEY from the environment)
OPENAI_API_KEY=your_openai_api_key_here
AGENT_NAME=Assistant
# AGENT_MODEL=
AGENT_MAX_TURNS=10
SSE_HEARTBEAT_SECONDS=15

# MCP servers the agent connects to (alarm: 8101, ticketing: 8102, knowledge: 8103).
# Path to a JSON file or inline JSON; see apps/backend/mcp_servers.sample.json
MCP_SERVERS_CONFIG=./apps/backend/mcp_servers.json
# Seconds a run paused for tool approval waits for the user's decision
APPROVAL_TTL_SECONDS=900

# Database pool settings (the connection itself is configured in the Database section)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

LOG_LEVEL=INFO

# ==========================================
# Alarms & Ticketing simulator (apps/alarms_and_ticket_simulation_api)
# ==========================================
# Listens on http://localhost:8000 (uvicorn simulator_app:app / docker compose).
# It reads no settings from the environment; it accepts Bearer "demo-token"
# and serves mock_data.json. Only PYTHONUNBUFFERED is set by its compose file.
# The MCP servers below point at it.

# ==========================================
# Alarm Management MCP (mcp_servers/alarm-management)
# ==========================================
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=demo-token
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=2
ALARM_API_CLIENT_ID=alarm-mcp-server

# ==========================================
# Ticketing MCP (mcp_servers/ticketing)
# ==========================================
TICKETING_API_BASE_URL=http://localhost:8000
TICKETING_API_TOKEN=demo-token
TICKETING_TIMEOUT_SECONDS=10
TICKETING_MAX_RETRIES=2
TICKETING_RETRY_BACKOFF_SECONDS=0.5
TICKETING_CLIENT_ID=ticketing-mcp

# ==========================================
# Knowledge Base MCP (mcp_servers/knowledge-base)
# ==========================================
# Reads the chunks written by ingestion from the shared database (see Database
# and Gemini sections). Leave GEMINI_API_KEY empty to use the deterministic
# mock embeddings.
DB_COMMAND_TIMEOUT_SECONDS=10
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=2
# Max chunks stitched into one kb://documents/{id} resource
MAX_DOCUMENT_CHUNKS=2000

# ==========================================
# Shared: Gemini embeddings (ingestion + knowledge-base MCP; must match)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSION=768

# ==========================================
# Database: Neon Postgres (single DB shared by all services)
# ==========================================
# Full connection string (used by the backend; wins over POSTGRES_* there).
# Neon requires SSL.
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your-endpoint.neon.tech/your_db?ssl=require

# Same database as individual parameters (ingestion, knowledge-base MCP, backend fallback)
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=your-endpoint.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=your_db
POSTGRES_SSLMODE=require

# Create the chat history tables (agent_sessions, agent_messages) on startup.
# Keep false in production.
DB_CREATE_TABLES=true

# ==========================================
# Ingestion pipeline (ingestion)
# ==========================================
# Rate-limit safeguards (100 RPM, 30K TPM, 1K RPD)
RATE_LIMIT_MAX_RPM=80
RATE_LIMIT_MAX_TPM=24000
RATE_LIMIT_MAX_RPD=950

# Redis task queue & rate limiter
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_QUEUE_NAME=ingestion:queue

# Chunking & batching
UPLOAD_DIR=./uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_BATCH_SIZE=30
TARGET_BATCH_TOKENS=6000
