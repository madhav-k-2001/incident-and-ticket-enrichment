# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=copilot_db
POSTGRES_SSLMODE=prefer

# Alternatively, specify a single connection string:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copilot_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# Create the chat history tables (agent_sessions, agent_messages) on first use.
# Leave false in production and manage the tables with migrations.
DB_CREATE_TABLES=true

# ==========================================
# MCP servers and tool approval
# ==========================================
# Path to a JSON file (or inline JSON) describing the MCP servers. Tools listed
# under a server's "require_approval" pause the agent until the user approves.
# MCP_SERVERS_CONFIG=./mcp_servers.json
# Seconds a paused run waits for the user's decision before it is discarded.
APPROVAL_TTL_SECONDS=900
