# Alarm Management API (source system)
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=demo-token
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=2
ALARM_API_CLIENT_ID=alarm-mcp-server

# MCP transport: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8100

LOG_LEVEL=INFO
